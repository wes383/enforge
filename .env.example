# Application
APP_NAME=Deep Research Writing Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PORT=8000
WEB_PORT=3000

# Browser-facing API address. Rebuild the web image after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (internal Docker network only)
POSTGRES_USER=enforge
POSTGRES_PASSWORD=enforge_dev_password
POSTGRES_DB=enforge

# Redis (internal Docker network only)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_DEFAULT_QUEUE=research
CELERY_PARSE_QUEUE=parse

# Long-running research task behavior.
RUN_TASK_MAX_RETRIES=3
RUN_TASK_SOFT_TIME_LIMIT_SECONDS=300
RUN_TASK_HARD_TIME_LIMIT_SECONDS=360
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_KEEPALIVE_SECONDS=15.0

# Shared file volume settings
FILE_STORAGE_ROOT=/app/data/files
MAX_UPLOAD_BYTES=5242880

# External research providers. All real providers are disabled by default;
# tests use deterministic Mock providers and never require network access.
TAVILY_ENABLED=false
TAVILY_API_KEY=
EXA_ENABLED=false
EXA_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
CROSSREF_ENABLED=false
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=

# Optional OpenAI-compatible chat model for planning / evidence / writing /
# polish / claim review. The adapter registers only when OPENAI_API_KEY is set;
# the workflow still requires the matching RESEARCH_*_ENABLED flag to call it.
# Works with any OpenAI-compatible endpoint (OpenAI, Azure gateway, vLLM, Ollama).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Reasoning models need tens of seconds per section, so generation gets its own
# budget instead of the 20s search default. A timed-out section falls back to
# deterministic writing.
LLM_REQUEST_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=0
# Optional prices for the configured endpoint, in USD per 1M tokens. Every call's
# usage is added to the run either way; cost stays 0 until both are set.
LLM_COST_PER_1M_INPUT_TOKENS=0
LLM_COST_PER_1M_OUTPUT_TOKENS=0

PROVIDER_REQUEST_TIMEOUT_SECONDS=20
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
PROVIDER_CACHE_TTL_SECONDS=900
FIRECRAWL_MAX_CONCURRENCY=2
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MIN_CONTENT_CHARS=400

# Local document parsing (pypdf, trafilatura, BeautifulSoup)
PARSER_MAX_INPUT_BYTES=5242880
PARSER_MAX_OUTPUT_CHARS=2000000
PARSER_MAX_PDF_PAGES=200
PARSE_TASK_SOFT_TIME_LIMIT_SECONDS=240
PARSE_TASK_HARD_TIME_LIMIT_SECONDS=300

# LangGraph research workflow. "auto" uses real providers when configured and
# deterministic mocks outside production when none are available.
RESEARCH_PROVIDER_MODE=auto
RESEARCH_MAX_SEARCH_ROUNDS=3
RESEARCH_MAX_QUERIES_PER_ROUND=6
RESEARCH_MAX_SOURCES=20
RESEARCH_MAX_FETCHES_PER_ROUND=8
RESEARCH_MAX_EVIDENCE=40
RESEARCH_MAX_FETCH_CONCURRENCY=2
RESEARCH_NODE_TIMEOUT_SECONDS=90
RESEARCH_TOKEN_BUDGET=0
RESEARCH_COST_BUDGET_USD=0
RESEARCH_OUTLINE_APPROVAL_REQUIRED=true
RESEARCH_RETRIEVAL_MODE=hybrid
RESEARCH_RETRIEVAL_LIMIT=10
RESEARCH_CHUNK_MAX_CHARS=1200
# Optional semantic writing/claim review. Deterministic validation always runs;
# these flags only enable an additionally configured real LLM provider.
RESEARCH_LLM_WRITING_ENABLED=false
RESEARCH_CLAIM_LLM_REVIEW=false
# Lets the model order and frame the article's body sections (titles, purposes,
# key claims and word budgets). Evidence assignment plus the introduction,
# contradiction, limitation and conclusion frame stay deterministic, so a
# rejected outline simply falls back to the deterministic template.
RESEARCH_LLM_OUTLINE_ENABLED=false
# Whole-article rewrite for language and flow (terminology, transitions, repeated
# conclusions) after the sections are written. It never changes facts, numbers or
# citation markers; a rejected rewrite keeps the section as written. Articles
# longer than the input cap are left untouched.
RESEARCH_LLM_POLISH_ENABLED=false
RESEARCH_POLISH_MAX_INPUT_CHARS=24000
# Two bounded agents. The planning agent runs before the single outline
# approval: it searches, reads full pages and follows citations and names it
# discovers, then commits to the article outline. The evidence agent runs after
# approval inside the frozen sections and may choose new keywords, but cannot
# change the structure. Both require a real OpenAI-compatible tool-calling
# provider and an enabled search provider. Every source still goes through
# normal ingestion; neither agent can supply citations.
RESEARCH_AGENT_ENABLED=false
RESEARCH_AGENT_MAX_ROUNDS=6
RESEARCH_AGENT_MAX_SEARCHES=12
RESEARCH_AGENT_MAX_TOOL_CALLS=18
RESEARCH_AGENT_MAX_SOURCES=16
RESEARCH_AGENT_MAX_FETCHES=6
RESEARCH_AGENT_MAX_CITATION_CALLS=4
RESEARCH_AGENT_READ_CHARS=8000
# Write-time gap retrieval: when model writing is enabled and a search provider
# exists, a section may request targeted searches before it is written. These
# caps bound the extra work per run (and per section for requests).
RESEARCH_WRITE_SEARCH_MAX_REQUESTS_PER_SECTION=2
RESEARCH_WRITE_SEARCH_MAX_SEARCHES=6
RESEARCH_WRITE_SEARCH_MAX_SOURCES=8
RESEARCH_WRITE_SEARCH_MAX_EVIDENCE=12
# Caps paid model calls during claim verification; the rest keep deterministic status.
RESEARCH_CLAIM_LLM_REVIEW_LIMIT=10

# Per-project concurrency guard. Set to 0 to disable.
MAX_ACTIVE_RUNS_PER_PROJECT=3

# Optional Langfuse observability. Disabled by default; the MVP runs offline.
# Metadata only by default. Set OBSERVABILITY_INCLUDE_CONTENT=true only if you
# accept prompt/response excerpts being sent to the observability backend.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TIMEOUT_SECONDS=5
OBSERVABILITY_INCLUDE_CONTENT=false

# Embedding vector dimension. Changing this requires a new Alembic migration
# because document_chunks.embedding is a fixed-size pgvector column.
EMBEDDING_DIMENSION=1536

# Development-only smoke and failure-injection endpoints. Disable outside local development.
ENABLE_DEV_ENDPOINTS=true
