# Application
APP_NAME=Deep Research Writing Agent
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PORT=8000
WEB_PORT=3000

# Browser-facing API address. Rebuild the web image after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL (internal Docker network only)
POSTGRES_USER=enforge
POSTGRES_PASSWORD=enforge_dev_password
POSTGRES_DB=enforge

# Redis (internal Docker network only)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_DEFAULT_QUEUE=research
CELERY_PARSE_QUEUE=parse

# Long-running research task behavior.
RUN_TASK_MAX_RETRIES=3
RUN_TASK_SOFT_TIME_LIMIT_SECONDS=300
RUN_TASK_HARD_TIME_LIMIT_SECONDS=360
SSE_POLL_INTERVAL_SECONDS=1.0
SSE_KEEPALIVE_SECONDS=15.0

# Shared file volume settings
FILE_STORAGE_ROOT=/app/data/files
MAX_UPLOAD_BYTES=5242880

# External research providers. All real providers are disabled by default;
# tests use deterministic Mock providers and never require network access.
TAVILY_ENABLED=false
TAVILY_API_KEY=
EXA_ENABLED=false
EXA_API_KEY=
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=
CROSSREF_ENABLED=false
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_ENABLED=false
SEMANTIC_SCHOLAR_API_KEY=

PROVIDER_REQUEST_TIMEOUT_SECONDS=20
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_MAX_RETRIES=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
PROVIDER_CACHE_TTL_SECONDS=900
FIRECRAWL_MAX_CONCURRENCY=2
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MIN_CONTENT_CHARS=400

# Local document parsing (pypdf, trafilatura, BeautifulSoup)
PARSER_MAX_INPUT_BYTES=5242880
PARSER_MAX_OUTPUT_CHARS=2000000
PARSER_MAX_PDF_PAGES=200
PARSE_TASK_SOFT_TIME_LIMIT_SECONDS=240
PARSE_TASK_HARD_TIME_LIMIT_SECONDS=300

# LangGraph research workflow. "auto" uses real providers when configured and
# deterministic mocks outside production when none are available.
RESEARCH_PROVIDER_MODE=auto
RESEARCH_MAX_SEARCH_ROUNDS=3
RESEARCH_MAX_QUERIES_PER_ROUND=6
RESEARCH_MAX_SOURCES=20
RESEARCH_MAX_FETCHES_PER_ROUND=8
RESEARCH_MAX_EVIDENCE=40
RESEARCH_MAX_FETCH_CONCURRENCY=2
RESEARCH_NODE_TIMEOUT_SECONDS=90
RESEARCH_TOKEN_BUDGET=0
RESEARCH_COST_BUDGET_USD=0
RESEARCH_PLAN_APPROVAL_REQUIRED=true
RESEARCH_OUTLINE_APPROVAL_REQUIRED=true
RESEARCH_RETRIEVAL_MODE=hybrid
RESEARCH_RETRIEVAL_LIMIT=10
RESEARCH_CHUNK_MAX_CHARS=1200

# Embedding vector dimension. Changing this requires a new Alembic migration
# because document_chunks.embedding is a fixed-size pgvector column.
EMBEDDING_DIMENSION=1536

# Development-only smoke and failure-injection endpoints. Disable outside local development.
ENABLE_DEV_ENDPOINTS=true

# Reserved for later phases. The system runs with deterministic mocks when these are empty.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
